            </div>
        </div>
        <button id="btn-save-quiz" onclick="saveQuiz()" class="w-full btn bg-blue-500 text-white font-black py-4 rounded-2xl mt-8 shadow-[0_4px_0_#2563eb] active:translate-y-[4px] active:shadow-none text-lg">SIMPAN PAKET</button>
    </div>
</div>

<!-- Edit Quiz Modal -->
<div id="modal-edit-quiz" class="fixed inset-0 z-50 hidden items-center justify-center modal-overlay p-4">
