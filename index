        <button onclick="logout()" class="mt-4 bg-red-50 text-red-500 font-bold text-sm py-3 rounded-xl hover:bg-red-100 text-center">Keluar Akun</button>
    </aside>

    <!-- Mobile Nav -->
    <div class="md:hidden fixed top-0 w-full bg-white border-b border-slate-200 p-4 flex justify-between items-center z-20 shadow-sm">
        <span class="text-indigo-600 font-black text-xl">ðŸŽ® JEOPARDY</span>
        <select onchange="if(this.value==='play'){showScreen('screen-setup');initSetup();}else if(this.value==='out')logout();else goAdmin(this.value);" class="bg-indigo-50 text-indigo-700 font-bold p-2 rounded-xl outline-none border border-indigo-100">
            <option value="dash">ðŸ  Dashboard</option><option value="quiz">ðŸ“¦ Paket Kuis</option><option value="bank">ðŸ“š Bank Soal</option><option value="import">ðŸ“¥ Import</option>
            <option value="play">â–¶ MULAI GAME</option><option value="out">Keluar</option>
        </select>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col h-full overflow-hidden pt-16 md:pt-0 bg-slate-50">
        <!-- Sub: Dashboard -->
        <div id="admin-sub-dash" class="flex-1 flex flex-col overflow-y-auto p-4 md:p-10">
            <!-- Header Section -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
                <div>
                    <h1 class="text-4xl font-black text-slate-800 mb-2 flex items-center gap-3">ðŸ‘‹ Halo, Selamat Datang!</h1>
                    <p class="text-slate-500 font-bold text-lg">Kelola seluruh permainan kelas Anda dengan mudah dan menyenangkan.</p>
                </div>
                <button onclick="showScreen('screen-setup'); initSetup();" class="btn bg-gradient-to-r from-yellow-300 to-orange-400 text-orange-950 font-black py-3 px-8 rounded-full shadow-[0_6px_0_#c2410c] hover:translate-y-[2px] hover:shadow-[0_4px_0_#c2410c] active:translate-y-[6px] active:shadow-none border-4 border-white text-lg flex items-center gap-2">
                    <span class="text-2xl anim-bounce">ðŸŽ®</span> MULAI GAME BARU!
                </button>
            </div>
            
            <!-- Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                <div class="bg-gradient-to-br from-blue-100 to-blue-50 border-2 border-white p-6 rounded-[2rem] shadow-lg flex flex-row items-center gap-6 cursor-pointer transition-transform hover:scale-105" onclick="goAdmin('quiz')">
                    <div class="text-5xl bg-white w-20 h-20 rounded-[1.5rem] flex items-center justify-center shadow-sm border border-blue-50">ðŸ“¦</div>
                    <div>
                        <div class="text-blue-600 font-black text-4xl drop-shadow-sm" id="dash-count-qz">0</div>
                        <div class="text-blue-500 font-black text-xs uppercase tracking-wider mt-1 bg-white px-3 py-1 rounded-full shadow-sm inline-block">Paket Kuis</div>
                    </div>
                </div>
                <div class="bg-gradient-to-br from-emerald-100 to-emerald-50 border-2 border-white p-6 rounded-[2rem] shadow-lg flex flex-row items-center gap-6 cursor-pointer transition-transform hover:scale-105" onclick="goAdmin('bank')">
                    <div class="text-5xl bg-white w-20 h-20 rounded-[1.5rem] flex items-center justify-center shadow-sm border border-emerald-50">ðŸ“š</div>
                    <div>
                        <div class="text-emerald-600 font-black text-4xl drop-shadow-sm" id="dash-count-qs">0</div>
                        <div class="text-emerald-500 font-black text-xs uppercase tracking-wider mt-1 bg-white px-3 py-1 rounded-full shadow-sm inline-block">Total Soal</div>
                    </div>
                </div>
                <div class="bg-gradient-to-br from-purple-100 to-purple-50 border-2 border-white p-6 rounded-[2rem] shadow-lg flex flex-row items-center gap-6">
                    <div class="text-5xl bg-white w-20 h-20 rounded-[1.5rem] flex items-center justify-center shadow-sm border border-purple-50">ðŸ•¹ï¸</div>
                    <div>
                        <div class="text-purple-600 font-black text-4xl drop-shadow-sm" id="dash-count-gm">0</div>
                        <div class="text-purple-500 font-black text-xs uppercase tracking-wider mt-1 bg-white px-3 py-1 rounded-full shadow-sm inline-block">Sesi Dimainkan</div>
                    </div>
                </div>
            </div>

            <!-- Recent Activity Section -->
            <div class="bg-white rounded-[2rem] p-8 shadow-xl border-4 border-white">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-black text-slate-800 flex items-center gap-2"><span>â±ï¸</span> Riwayat Permainan Kelas</h2>
                    <span class="bg-indigo-50 text-indigo-500 font-black text-xs px-3 py-1 rounded-full border border-indigo-100">5 Sesi Terakhir</span>
                </div>
                <div id="dash-recent-games" class="flex flex-col gap-4">
                    <p class="text-slate-400 font-bold text-center py-6">Memuat riwayat...</p>
                </div>
            </div>
        </div>

        <!-- Sub: Paket Kuis -->
        <div id="admin-sub-quiz" class="hidden flex-1 flex-col overflow-hidden p-4 md:p-8">
            <div class="flex justify-between items-center mb-6 shrink-0">
                <h2 class="text-3xl font-black text-slate-800">ðŸ“¦ Paket Kuis</h2>
                <button onclick="openCreateQuizModal()" class="btn bg-blue-500 hover:bg-blue-600 text-white font-black py-3 px-6 rounded-2xl text-sm shadow-[0_4px_0_#2563eb] active:translate-y-[4px] active:shadow-none">+ BUAT PAKET BARU</button>
            </div>
            <div id="quiz-list-container" class="flex-1 overflow-y-auto grid grid-cols-1 lg:grid-cols-2 gap-6 content-start pb-10"></div>
        </div>

        <!-- Sub: Bank Soal -->
        <div id="admin-sub-bank" class="hidden flex-1 flex-col overflow-hidden p-4 md:p-8">
