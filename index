                <button id="btn-do-import" onclick="executeImport()" class="btn w-full bg-emerald-400 text-white font-black py-4 mt-6 rounded-2xl shadow-[0_4px_0_#059669] active:translate-y-[4px] active:shadow-none text-lg tracking-wider">SIMPAN KE DATABASE</button>
            </div>
        </div>
    </div>
</main>

<!-- MODALS UNTUK ADMIN -->
<!-- Create Quiz Modal -->
<div id="modal-create-quiz" class="fixed inset-0 z-50 hidden items-center justify-center modal-overlay p-4">
    <div class="bg-white rounded-[2rem] shadow-2xl border-4 border-white w-full max-w-lg p-8 relative">
        <button onclick="closeModal('modal-create-quiz')" class="absolute top-4 right-4 bg-slate-100 w-10 h-10 rounded-full text-slate-400 hover:text-slate-800 font-black text-xl flex items-center justify-center">&times;</button>
        <h2 class="text-2xl font-black text-slate-800 mb-6 flex items-center gap-2"><span>ðŸ“¦</span> Buat Paket Baru</h2>
