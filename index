        list.innerHTML = '';
        parsedImportItems.forEach((it, idx) => {
            list.innerHTML += `<div class="text-slate-600 font-bold bg-white p-2 mb-1 rounded border border-slate-100"><span class="text-blue-500 mr-2">[#${idx+1}]</span> ${it.cat} | ${it.score} Pts | ${it.q} <span class="text-emerald-500 ml-2">(Ans: ${it.a})</span></div>`;
        });
        
        cnt.innerText = `${parsedImportItems.length} soal valid`;
