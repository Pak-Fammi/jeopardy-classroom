                             <button onclick="duplicateQuiz('${q.id}')" class="btn bg-slate-100 hover:bg-slate-200 text-slate-600 font-black px-4 py-3 rounded-xl text-xs border border-slate-200" title="Duplikat">ðŸ“‹</button>`}
