    <div class="absolute bottom-10 right-10 w-40 h-40 bg-pink-300 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-pulse" style="animation-delay: 2s;"></div>
    
    <div class="z-10 text-center px-4 flex flex-col items-center w-full bg-white/40 p-12 rounded-3xl backdrop-blur-sm border-2 border-white shadow-2xl max-w-2xl mx-auto">
        <div class="text-7xl mb-4 anim-bounce drop-shadow-md">ðŸŽ®</div>
        <h1 class="text-5xl md:text-7xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 mb-2 drop-shadow-sm">JEOPARDY</h1>
        <h2 class="text-2xl font-bold text-indigo-900 tracking-widest mb-10 bg-indigo-100 px-6 py-2 rounded-full">CLASSROOM 2.5</h2>
