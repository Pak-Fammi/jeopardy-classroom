    function formatQuestionText(text) {
        const hasOptions = /A[\.\)]\s/.test(text) && /B[\.\)]\s/.test(text);
        
        if(hasOptions) {
            const regex = /\s*(A[\.\)]\s+|B[\.\)]\s+|C[\.\)]\s+|D[\.\)]\s+|E[\.\)]\s+)/;
            const parts = text.split(regex).filter(Boolean); 
            
            if (parts.length > 1) {
                const mainQ = parts.shift();
                let html = `<div class="mb-8 leading-relaxed">${mainQ.trim()}</div><div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full max-w-4xl mx-auto text-left mt-6">`;
                
                for (let i = 0; i < parts.length; i += 2) {
                    const label = parts[i] ? parts[i].trim() : '';
                    const optionText = parts[i+1] ? parts[i+1].trim() : '';
                    if (label && optionText) {
                         html += `<div class="bg-white border-2 border-slate-100 rounded-2xl p-5 text-lg md:text-xl font-bold shadow-sm flex items-start">
                                    <span class="mr-3 text-indigo-500 font-black min-w-[30px] bg-indigo-50 px-2 py-0.5 rounded-lg text-center">${label}</span> 
                                    <span class="text-slate-700">${optionText}</span>
                                  </div>`;
                    }
                }
                html += `</div>`;
                return html;
            }
        }
        return `<div class="leading-relaxed">${text}</div>`;
    }

