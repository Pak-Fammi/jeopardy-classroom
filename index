                <h2 class="text-3xl font-black text-slate-800">ðŸ“š Bank Soal</h2>
                <div class="flex gap-3">
                    <button onclick="goAdmin('import')" class="btn bg-white border-2 border-slate-200 text-slate-600 font-black py-3 px-6 rounded-2xl text-sm hover:bg-slate-50 shadow-sm">ðŸ“¥ Import Excel</button>
                    <button onclick="openQuestionModal()" class="btn bg-emerald-400 hover:bg-emerald-500 text-white font-black py-3 px-6 rounded-2xl text-sm shadow-[0_4px_0_#059669] active:translate-y-[4px] active:shadow-none">+ TAMBAH SOAL</button>
                </div>
            </div>
            <div class="flex gap-3 mb-6 shrink-0 overflow-x-auto pb-2 bg-white p-3 rounded-2xl shadow-sm border border-slate-100">
