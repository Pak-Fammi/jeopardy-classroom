            <div class="grid grid-cols-2 gap-4">
                <div><label class="text-xs text-slate-400 font-black block mb-1 uppercase tracking-wide">Jenjang</label><select id="cq-lv" class="w-full bg-slate-50 border-2 border-slate-200 text-slate-700 p-3 rounded-xl outline-none font-bold focus:border-blue-400" onchange="cascadeLevel('cq-lv','cq-cl',null,null)"></select></div>
