        const lines = text.split('\n'); 
        parsedImportItems = [];
        
        lines.forEach(line => {
            let cols = line.split('\t');
            if (cols.length < 4 && line.includes('|')) { cols = line.split('|'); }

            if(cols.length >= 4) {
                parsedImportItems.push({ 
                    cat: cols[0].trim(), 
                    score: parseInt(cols[1]) || 10, 
                    q: cols[2].trim(), 
                    a: cols[3].trim(), 
                    sp: cols[4] ? cols[4].trim().toUpperCase() : 'NORMAL' 
