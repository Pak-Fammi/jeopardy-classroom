                </div>
                <textarea id="imp-text" rows="6" class="w-full bg-slate-50 border-2 border-slate-200 text-slate-700 p-4 rounded-2xl font-mono text-sm outline-none focus:border-indigo-400 focus:bg-white transition-colors" placeholder="Klik disini dan tekan Ctrl+V..."></textarea>
                
                <div class="mt-6 flex justify-end gap-3">
