    function formatBoardData(qList) {
        const map = {}; if(!qList) return { categories: [], data: {} }; 
        qList.forEach(q => { if(!map[q.cat]) map[q.cat] = []; map[q.cat].push(q); });
        const cats = Object.keys(map); cats.forEach(c => map[c].sort((a,b) => a.score - b.score));
        return { categories: cats, data: map };
    }

    function buildBoard() {
        const b = state.game.boardData; const grid = document.getElementById('jeopardy-grid'); if(!grid) return; 
