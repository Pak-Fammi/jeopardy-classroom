                                <div class="flex items-center gap-5">
                                    <div class="bg-indigo-50 w-14 h-14 rounded-full flex items-center justify-center text-3xl shadow-inner border border-indigo-100">ðŸ•¹ï¸</div>
                                    <div>
                                        <h3 class="font-black text-slate-700 text-xl mb-1">${g.quizName}</h3>
                                        <p class="text-xs text-slate-500 font-bold bg-slate-50 px-2 py-0.5 rounded border border-slate-100 inline-block">ðŸ—“ï¸ ${dateStr}</p>
                                        <p class="text-xs text-indigo-500 font-bold bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100 inline-block ml-1">ðŸ‘¥ ${g.teamsCount} Tim Bersaing</p>
                                    </div>
                                </div>
                                <div>${statusBadge}</div>
                            </div>
                        `;
                    });
                }
            }
        } catch(e) { showToast("Gagal memuat dashboard", "error"); }
    }

    async function loadQuizzes() {
        const container = document.getElementById('quiz-list-container'); if(!container) return; container.innerHTML = '<p class="text-slate-500 font-bold">Memuat paket kuis...</p>';
        try {
