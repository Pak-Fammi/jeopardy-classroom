        if (q.sp === 'ZONK' || (q.sp && q.sp.startsWith('MINUS'))) { triggerSpecialCard(q); return; }
        
        const catEl = document.getElementById('q-modal-category'), scoreEl = document.getElementById('q-modal-score'), textEl = document.getElementById('q-modal-text'), ansEl = document.getElementById('q-modal-answer'), mult = document.getElementById('q-modal-multiplier');
        if(catEl) catEl.innerText = catName; if(scoreEl) scoreEl.innerText = `${q.score} PTS`; 
        
        if(textEl) textEl.innerHTML = formatQuestionText(q.q); 
        if(ansEl) ansEl.innerText = q.a;
        
        if(mult) mult.classList.add('hidden');

        if(q.sp && q.sp.startsWith('BONUS') && (!q.att || q.att.length === 0)) { 
