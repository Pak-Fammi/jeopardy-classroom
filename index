        const qData = state.game.boardData.data[cell.cat][cell.idx]; if(!qData) return;
        
        const isSteal = state.game.q.attemptedIds.length > 0;
        const nextTeam = isCorrect ? state.game.q.answeringTeamId : getNextActiveTeamId(state.game.activeTeamId);
        
        const p = { 
            sessionId: state.game.sessionId, teamId: state.game.q.answeringTeamId, gqId: qData.gqId, qId: qData.qId, 
            result: isCorrect ? 'CORRECT' : 'WRONG', awarded: (qData.score * state.game.q.multiplier), baseScore: qData.score,
            nextActiveTeamId: nextTeam, isSteal: isSteal, allWrong: (!isCorrect && state.game.q.attemptedIds.length + 1 >= state.game.teams.length)
        };

        try {
            const res = await apiCall('submitAnswerResult', p);
            updateTeamScoreUI(res.team.teamId, res.team.currentScore);
            
            const pv = document.getElementById('q-phase-validate'); if(pv) { pv.classList.add('hidden'); pv.classList.remove('flex'); }
            
            if(isCorrect) {
                Sound.correct(); qData.status = 'USED'; state.game.activeTeamId = res.activeTeamId; updateActiveTeamHeader();
                showToast(`âœ… YAY! +${p.awarded} POIN!`, 'success'); forceShowAnswer(true);
            } else {
                Sound.wrong(); state.game.q.attemptedIds.push(p.teamId); qData.att = state.game.q.attemptedIds;
                if(p.allWrong) {
                    showToast("Semua tim keliru menjawab."); qData.status = 'USED'; state.game.activeTeamId = res.activeTeamId; updateActiveTeamHeader(); forceShowAnswer(false);
                } else {
                    const sb = document.getElementById('q-steal-banner'), st = document.getElementById('q-select-title'), ps = document.getElementById('q-phase-select');
                    if(sb) sb.classList.remove('hidden'); if(st) st.innerText = "âš¡ TIM LAIN SILAKAN MEREBUT!";
                    buildTeamSelectors(); if(ps){ ps.classList.remove('hidden'); ps.classList.add('flex'); }
                }
            }
        } catch(e) {
            showToast(e, 'error'); 
            const pv = document.getElementById('q-phase-validate'); if(pv) { pv.classList.remove('hidden'); pv.classList.add('flex'); }
        }
        if(btnY) { btnY.disabled = false; btnY.innerText = "âœ… BENAR"; } if(btnN) btnN.disabled = false;
    }

    function toggleAnswerReveal() { 
        if(!state.game.q.isRevealed) confirmAction("Buka Kunci Jawaban?", "Setelah jawaban tampil, soal akan dianggap selesai.", () => forceShowAnswer(false)); 
    }

    function forceShowAnswer(isCorrectFlow) {
        state.game.q.isRevealed = true; 
        const btnAnsWrap = document.getElementById('btn-toggle-ans')?.parentElement, ansBox = document.getElementById('q-ans-box'), ps = document.getElementById('q-phase-select'), pv = document.getElementById('q-phase-validate'), pf = document.getElementById('q-phase-finished');
        if(btnAnsWrap) btnAnsWrap.classList.add('hidden'); if(ansBox) { ansBox.classList.remove('hidden'); ansBox.classList.add('flex'); }
        if(ps) { ps.classList.add('hidden'); ps.classList.remove('flex'); } if(pv) { pv.classList.add('hidden'); pv.classList.remove('flex'); } if(pf) { pf.classList.remove('hidden'); pf.classList.add('flex'); }
        
        if(!isCorrectFlow) {
            const cell = state.game.q.activeCell; if(!cell) return; const qData = state.game.boardData.data[cell.cat][cell.idx]; if(qData) qData.status = 'USED';
        }
    }

    function closeQuestionModal() { closeModal('modal-question'); buildBoard(); checkGameCompletion(); }
    function closeQuestionFinished() { closeQuestionModal(); }
    
    async function requestSkipQuestion() { 
        const cell = state.game.q.activeCell; if(!cell) return; const qData = state.game.boardData.data[cell.cat][cell.idx]; if(!qData) return;
        try {
            const nextTeam = getNextActiveTeamId(state.game.activeTeamId);
            await apiCall('skipQuestion', { sessionId: state.game.sessionId, gqId: qData.gqId, nextActiveTeamId: nextTeam });
            qData.status = 'SKIPPED'; state.game.activeTeamId = nextTeam; updateActiveTeamHeader(); closeModal('modal-question'); buildBoard(); checkGameCompletion();
        } catch(e) { showToast(e, 'error'); }
    }

    function triggerSpecialCard(q) {
        Sound.special(); const tb = document.getElementById('special-team-buttons'), titleEl = document.getElementById('special-title'), descEl = document.getElementById('special-desc'), bg = document.getElementById('special-bg');
        let title = "ZONK!", desc = "Yahhh, skor tim hangus jadi 0!", color = "text-rose-500", amt = 0, t = "ZONK";
        
        if(bg) bg.className = "absolute inset-0 bg-white/90 backdrop-blur-md anim-flash-red"; 
        
        if(q.sp && q.sp.includes('MINUS')) { amt = parseInt(q.sp.split('_')[1]) || 25; title = `MINUS ${amt}!`; desc = `Aduh kena ranjau! Kurang ${amt} poin!`; color = "text-orange-500"; t = "MINUS"; }
        
        if(titleEl) { titleEl.innerText = title; titleEl.className = `text-7xl md:text-[120px] font-black mb-2 drop-shadow-md uppercase tracking-tighter anim-shake leading-none ${color}`; } if(descEl) descEl.innerText = desc;
        if(tb) { 
            tb.innerHTML = ''; 
            if(state.game.teams) {
                state.game.teams.forEach(team => { 
                    const btn = document.createElement('button'); btn.className = "btn bg-slate-100 text-slate-700 font-black py-4 px-8 rounded-2xl border-4 border-slate-200 text-xl hover:bg-slate-200 shadow-sm m-1 transition-colors"; btn.innerText = team.name;
                    btn.onclick = () => applySpecial(team.id, q.gqId, q.qId, t, amt); tb.appendChild(btn); 
                }); 
            }
        }
        openModal('modal-special');
    }

    async function applySpecial(teamId, gqId, qId, type, amt) {
        closeModal('modal-special'); const nextTeam = getNextActiveTeamId(state.game.activeTeamId);
        try {
            const res = await apiCall('applySpecialCard', { sessionId: state.game.sessionId, teamId: teamId, gqId: gqId, qId: qId, type: type, amount: amt, nextActiveTeamId: nextTeam });
            updateTeamScoreUI(res.team.teamId, res.team.currentScore);
            const bd = state.game.boardData; for(let c of bd.categories) { for(let q of bd.data[c]) { if(q.gqId === gqId) { q.status = 'USED'; break; } } }
            state.game.activeTeamId = res.activeTeamId; buildBoard(); checkGameCompletion();
        } catch(e) { showToast(e, 'error'); }
    }

    async function manualScore(teamId, delta) {
        try { await apiCall('submitAnswerResult', { sessionId: state.game.sessionId, teamId: teamId, qId: '', result: delta > 0 ? 'MANUAL_PLUS' : 'MANUAL_MINUS', awarded: delta>0?delta:0, baseScore: delta<0?Math.abs(delta):0, nextActiveTeamId: state.game.activeTeamId, isSteal: false, allWrong: false, gqId: '' }); showToast("Skor sudah disesuaikan", "info"); const t = state.game.teams.find(x=>x.id===teamId); if(t) updateTeamScoreUI(teamId, t.score+delta); } catch(e) { showToast(e, "error"); }
    }
    
    function openEditScore(teamId) { state.editTeamId = teamId; const t = state.game.teams.find(x => x.id === teamId); const el = document.getElementById('edit-score-team'), inp = document.getElementById('input-new-score'); if(t && el && inp) { el.innerText = t.name; inp.value = t.score; openModal('modal-edit-score'); } }
    
    function saveManualScore() { const teamId = state.editTeamId, inp = document.getElementById('input-new-score'); if(!inp || !teamId) return; const targetScore = parseInt(inp.value) || 0; const t = state.game.teams.find(x => x.id === teamId); if(!t) return; const diff = targetScore - t.score; if(diff !== 0) manualScore(teamId, diff); closeModal('modal-edit-score'); }
    
    function updateTeamScoreUI(tId, newScore) { const t = state.game.teams.find(x => x.id === tId); if(t) t.score = newScore; const el = document.getElementById(`score-${tId}`); if(el) el.innerText = newScore; }
    
    async function requestUndo() {
        const btn = document.getElementById('btn-undo'); if(btn) btn.disabled = true;
        try { const res = await apiCall('undoLastScoreAction', { sessionId: state.game.sessionId }); updateTeamScoreUI(res.teamId, res.newScore); showToast("Undo berhasil (Skor dipulihkan)", 'success'); } catch(e) { showToast(e, 'error'); }
        if(btn) btn.disabled = false;
    }

    function executeExit() { apiCall('endGameSession', { sessionId: state.game.sessionId, isFinished: false }).catch(()=>{}); state.game = {settings:{sound:true}}; goAdmin('dash'); }
    
    function checkGameCompletion() {
        const bd = state.game.boardData; if(!bd.categories || bd.categories.length === 0) return;
        for(let c of bd.categories) { for(let q of bd.data[c]) { if(q.status === 'AVAILABLE') return; } }
        confirmAction("Semua Soal Sudah Selesai!", "Apakah Anda ingin melihat Papan Podium Pemenang?", finishGame);
    }
    
    function finishGame() {
        if(!state.game.teams) return;
        const ts = [...state.game.teams].sort((a,b) => b.score - a.score); const wId = ts.length > 0 ? ts[0].id : '';
        apiCall('endGameSession', { sessionId: state.game.sessionId, isFinished: true, winnerIds: wId }).catch(()=>{});
        
        const pl = document.getElementById('podium-list'); if(!pl) return; pl.innerHTML = '';
        
        ts.forEach((t, i) => { 
            let b="ðŸ‘", c="bg-white border-2 border-slate-100 text-slate-500", s="text-xl", tc="text-slate-600"; 
            
            let delay = (ts.length - 1 - i) * 1200; 
            let animStyle = `opacity: 0; animation: podiumPop 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) ${delay}ms forwards;`;

            if(i===0){ 
                b="ðŸ‘‘"; 
                c="bg-gradient-to-r from-yellow-300 to-yellow-400 border-4 border-white text-yellow-950 shadow-[0_15px_30px_rgba(234,179,8,0.4)] z-30 relative transform scale-110 mb-4"; 
                s="text-5xl"; tc="text-yellow-950 drop-shadow-sm"; 
                animStyle = `opacity: 0; animation: podiumWinner 1.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) ${delay}ms forwards;`;
            } 
            else if(i===1){ b="ðŸ¥ˆ"; c="bg-slate-100 border-4 border-white text-slate-800 shadow-xl z-20 relative mb-2"; s="text-3xl"; tc="text-slate-800"; } 
            else if(i===2){ b="ðŸ¥‰"; c="bg-orange-100 border-4 border-white text-orange-800 shadow-lg relative z-10 mb-1"; s="text-2xl"; tc="text-orange-900"; } 
            
            pl.innerHTML += `<div class="flex justify-between items-center p-6 md:p-8 rounded-[2rem] ${c}" style="${animStyle}">
                                <div class="flex items-center gap-5"><span class="${s} anim-bounce" style="animation-delay: ${delay + 500}ms">${b}</span><span class="font-black ${tc} ${s}">${t.name}</span></div>
                                <span class="font-black ${s} ${tc} bg-white/40 px-4 py-2 rounded-xl backdrop-blur-sm">${t.score} PTS</span>
                             </div>`; 
        });
        showScreen('screen-result');
    }
    function returnToDashboard() { state.game = {settings:{sound:true}}; goAdmin('dash'); }

    window.addEventListener('keydown', e => {
        if(e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;
        const qm = document.getElementById('modal-question'), pv = document.getElementById('q-phase-validate'), ps = document.getElementById('q-phase-select');
        const isQOpen = qm && qm.classList.contains('flex');
        
        if(isQOpen) {
            if((e.code === 'KeyB' || e.key === 'b') && pv && pv.classList.contains('flex')) processAnswer(true);
            if((e.code === 'KeyS' || e.key === 's') && pv && pv.classList.contains('flex')) processAnswer(false);
            if(e.key >= '1' && e.key <= '8' && ps && ps.classList.contains('flex') && state.game.teams) { 
                const idx = parseInt(e.key) - 1; if(idx < state.game.teams.length) { const t = state.game.teams[idx]; if(t && !state.game.q.attemptedIds.includes(t.id)) selectAnsweringTeam(t.id, t.name); } 
            }
        } else if(document.getElementById('screen-board') && document.getElementById('screen-board').classList.contains('active')) {
            if(e.code === 'KeyU' || e.key === 'u') requestUndo(); 
            if(e.code === 'KeyF' || e.key === 'f') toggleFullscreen();
        }
    });

</script>
