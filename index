        b.categories.forEach(c => { grid.innerHTML += `<div class="cat-header">${c}</div>`; });
        const maxRows = b.categories.length > 0 ? Math.max(...b.categories.map(c => b.data[c].length)) : 0;
        
        for (let r = 0; r < maxRows; r++) {
            for (let c = 0; c < b.categories.length; c++) {
                const catName = b.categories[c]; const q = b.data[catName][r]; const btn = document.createElement('button');
                if (q) {
                    const isUsed = q.status === 'USED' || q.status === 'SKIPPED';
                    btn.className = `btn flex items-center justify-center font-black text-4xl md:text-5xl py-8 rounded-[1.5rem] border-4 w-full shadow-md ${isUsed ? 'bg-slate-100 text-slate-300 border-slate-200 pointer-events-none opacity-60' : 'bg-gradient-to-b from-indigo-300 to-indigo-400 hover:from-indigo-400 hover:to-indigo-500 text-white border-white'}`;
                    btn.innerText = isUsed ? 'â€¢' : q.score; if(!isUsed) btn.onclick = () => openQuestion(catName, r);
