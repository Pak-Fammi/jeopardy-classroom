                <div><label class="text-xs text-slate-400 font-black block mb-1 uppercase tracking-wide">Nama Materi</label><input type="text" id="cq-ma" class="w-full bg-slate-50 border-2 border-slate-200 text-slate-700 p-3 rounded-xl font-bold outline-none focus:border-blue-400 focus:bg-white" placeholder="Cth: Past Tense"></div>
