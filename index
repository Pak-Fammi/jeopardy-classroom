                <input type="text" id="flt-bank-search" placeholder="Cari soal atau jawaban..." onkeyup="debounceSearch()" class="bg-slate-50 border-2 border-slate-200 text-slate-700 text-sm font-bold p-3 rounded-xl outline-none flex-1 min-w-[250px] focus:border-indigo-300">
            </div>
            <div class="flex-1 overflow-y-auto relative bg-transparent rounded-2xl">
                <div id="questions-table-body" class="space-y-4 pb-10"></div>
            </div>
            <div class="flex justify-between items-center mt-4 shrink-0 bg-white p-4 rounded-2xl shadow-sm border border-slate-100">
                <span id="q-page-info" class="text-slate-500 font-black text-sm bg-slate-100 px-3 py-1 rounded-lg">Hal 1</span>
                <div class="flex gap-2">
                    <button onclick="loadQuestions(state.admin.qPage - 1)" class="bg-white border-2 border-slate-200 text-slate-600 px-4 py-2 rounded-xl hover:bg-slate-50 font-black text-sm">â—€ Mundur</button>
                    <button onclick="loadQuestions(state.admin.qPage + 1)" class="bg-white border-2 border-slate-200 text-slate-600 px-4 py-2 rounded-xl hover:bg-slate-50 font-black text-sm">Maju â–¶</button>
                </div>
            </div>
        </div>

        <!-- Sub: Import -->
        <div id="admin-sub-import" class="hidden flex-1 flex-col overflow-hidden p-4 md:p-8">
            <h2 class="text-3xl font-black text-slate-800 mb-2">ðŸ“¥ Import Massal (Excel)</h2>
            <p class="text-slate-500 font-bold text-sm mb-6">Pilih paket kuis, lalu paste (tempel) tabel dari Excel atau Google Sheets ke kotak di bawah.</p>
            
            <div class="bg-white p-6 rounded-3xl border-2 border-white shadow-xl mb-6 shrink-0 max-w-4xl">
                <label class="block text-sm font-black text-slate-400 mb-2 uppercase tracking-wide">1. Pilih Target Paket Kuis</label>
                <select id="imp-quiz" class="w-full bg-slate-50 border-2 border-slate-200 text-slate-800 p-4 rounded-2xl font-bold mb-6 outline-none focus:border-indigo-400"><option value="">Pilih Paket...</option></select>
                
